# Copy this file to .env and replace the example values
# You can use any valid OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Choose the model you want to use for chat completions.
# Some commonly available OpenAI models include:
# - gpt-4o-mini
# - gpt-4o
# - gpt-4.1-mini
# - gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini
